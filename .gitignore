/venv/*
/.env
la_token_market_making_python/.env
# Nested .env files anywhere (root /.env above is anchored and misses subdirectories,
# e.g. python_scripts/schema_validation/.env which leaked once). Keep .env.example tracked.
**/.env
# Ignore Jupyter logs and checkpoints
jupyter.log
python_scripts/jupyter.log
**/.ipynb_checkpoints/
# Ignore Python bytecode caches
la_token_market_making_python/__pycache__/

# macOS system files
.DS_Store

# Google API credentials and tokens
*credentials*.json
token.json
**/credentials.json
**/token.json

# Apps Script sources that embed API keys / secrets (basename contains "credential(s)")
google_app_scripts/**/*redential*.gs
google_app_scripts/**/Credentials.js
# Exception: this ONE file is verified secret-free (seeds REPLACE_ME placeholders +
# reads Script Properties only) and MUST be tracked so a clasp push from its folder can
# never again delete the live accessor (2026-08-21 incident, thread 26819).
!google_app_scripts/1dsWecVwbN0dOvilIz9r8DNt7LD3Ay13V8G9qliow4tZtF5LHsvQOFpF7/Credentials.js
# 2026-09-18 (Gary): the negation above is the MODEL, not an exception. `clasp push`
# = projects.updateContent = REPLACES the remote file set; anything NOT pushed is
# DELETED live. So a secret-free Credentials.js must be TRACKED and PUSHED, never
# .claspignore'd -- the ignore is what let push delete the live accessor.
!google_app_scripts/1Jp8qNIBCZaRTlmOmbJoJmYnSFyXtQkUHP2Qv5uqKZpt0Ugo-e25nhASF/Credentials.js
!google_app_scripts/1BHAGZd_T1I5mQnqnAFqUJKX2x_N8Uv05n1O2OohRA908Ja8wVwVxaR7K/Credentials.js
!google_app_scripts/1DYSZKFYM-PsQuCMII7ki-T5H3D8q92yn-9GZ3lzUOLxpH8o3zyxLUFyO/Credentials.js
!google_app_scripts/19Wag9x-sjbLVgIsPh2vj90ZG7Rgq2iGaVOomAeAvtg6CdZKJHLZ9AJrC/Credentials.js
# Defensive: the ".gs.js" double-extension variant slipped past the rule above once
# (Credentials.gs.js leaked the Wix token). Catch any *Credential* .gs.js too.
google_app_scripts/**/*redential*.gs.js
!google_app_scripts/**/Credentials.sample.js
!google_app_scripts/1K1wcXFAopSA0cI7oBpu5bl1sagrJ2Quv44B0ppjiIxtl3MKJ_PCsppCf/Credentials.js
!google_app_scripts/1XmwyzzauOoLUZAbm5jK1GBwWNIDLHBrlA465a3EE7bnNW3cvhqzIR8ml/Credentials.js
# 1wONDeDwZ (TDG inventory mgmt: process_movement_telegram_logs): NO tracked accessor
existed, so a push from the repo folder would have DELETED the live Credentials.js and
broken the ANYONE_ANONYMOUS doGet inventory webhook (@v14) with
"ReferenceError: setApiKeys is not defined". Restored as a tracked secret-free accessor.
!google_app_scripts/1wONDeDwZ_fXNapDKpstWrBION3aV3r7NXwq7PCdqbW1LvI5ceaykQNbR/Credentials.js
# 1duQFfTO (TDG inventory mgmt): project had NO accessor at all -> every entry point
# failed with "ReferenceError: setApiKeys is not defined" at load. Restored 2026-09-18.
!google_app_scripts/1duQFfTO0Pj0lC4tPVNmMOhNOS1GvJgzqVxXbsEDu-eqt_64DwxvrOVyl/Credentials.js

